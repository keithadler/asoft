10 REM SNAKE - I J K M TO STEER, Q TO QUIT
20 REM POLLS THE KEYBOARD AT -16384, SO IT KEEPS MOVING
30 GR
40 DIM SX(300), SY(300)
45 REM SP SETS THE PACE. THE LOOP IS THE ONLY CLOCK THERE IS,
46 REM SO A FASTER MACHINE NEEDS A BIGGER NUMBER.
47 SP = 600000
50 HD = 0: TL = 0: CNT = 0: LN = 5
60 X = 20: Y = 20: DX = 1: DY = 0: SC = 0
70 FX = INT(RND(1) * 36) + 2: FY = INT(RND(1) * 36) + 2
80 COLOR= 13: PLOT FX,FY
90 K = PEEK(-16384)
100 IF K < 128 THEN 170
110 POKE -16368,0
120 K = K - 128
130 IF K = 73 AND DY = 0 THEN DX = 0: DY = -1
140 IF K = 74 AND DX = 0 THEN DX = -1: DY = 0
150 IF K = 75 AND DX = 0 THEN DX = 1: DY = 0
160 IF K = 77 AND DY = 0 THEN DX = 0: DY = 1
165 IF K = 81 THEN 400
170 X = X + DX: Y = Y + DY
180 IF X < 0 OR X > 39 OR Y < 0 OR Y > 39 THEN 300
190 IF SCRN(X,Y) = 15 THEN 300
200 IF X <> FX OR Y <> FY THEN 230
210 SC = SC + 1: LN = LN + 3
220 FX = INT(RND(1) * 36) + 2: FY = INT(RND(1) * 36) + 2: COLOR= 13: PLOT FX,FY
230 COLOR= 15: PLOT X,Y
240 SX(HD) = X: SY(HD) = Y: HD = HD + 1: IF HD > 299 THEN HD = 0
250 CNT = CNT + 1
260 IF CNT <= LN THEN 280
270 COLOR= 0: PLOT SX(TL),SY(TL): TL = TL + 1: CNT = CNT - 1: IF TL > 299 THEN TL = 0
280 FOR D = 1 TO SP: NEXT
290 GOTO 90
300 TEXT
310 PRINT "GAME OVER - SCORE ";SC
320 END
400 TEXT
410 PRINT "QUIT - SCORE ";SC
420 END
