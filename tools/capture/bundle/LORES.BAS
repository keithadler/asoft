10 REM LO-RES: ALL SIXTEEN COLOURS, AND SCRN READS THEM BACK
20 GR
30 FOR C = 0 TO 15
40 COLOR= C
50 FOR X = 0 TO 39
60 PLOT X, C * 2
70 PLOT X, C * 2 + 1
80 NEXT X
90 NEXT C
100 PRINT "SIXTEEN COLOURS. PRESS A KEY.";
110 GET K$
120 REM READ THE COLOURS BACK BEFORE ANY PRINT CAN SCROLL THE PAGE
130 S$ = "": FOR C = 0 TO 15: S$ = S$ + STR$( SCRN( 0, C * 2)) + " ": NEXT
140 TEXT : HOME
150 PRINT "SCRN READS BACK: ";S$
160 END
