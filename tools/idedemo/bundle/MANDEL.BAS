10 REM MANDELBROT, BANDED BY ESCAPE TIME
20 HGR
30 FOR PY = 0 TO 47
40 CY = (PY - 24) / 19
50 FOR PX = 0 TO 69
60 CX = (PX - 48) / 19
70 ZX = 0: ZY = 0: N = 0
80 ZT = ZX * ZX - ZY * ZY + CX
90 ZY = 2 * ZX * ZY + CY: ZX = ZT
100 N = N + 1
110 IF ZX * ZX + ZY * ZY < 4 AND N < 12 THEN 80
120 IF N >= 12 THEN HCOLOR=3: GOTO 180
130 C = N - INT(N / 4) * 4
140 IF C = 0 THEN HCOLOR=1
150 IF C = 1 THEN HCOLOR=2
160 IF C = 2 THEN HCOLOR=5
170 IF C = 3 THEN HCOLOR=6
180 FOR DY = 0 TO 3
190 HPLOT PX * 4, PY * 4 + DY TO PX * 4 + 3, PY * 4 + DY
200 NEXT DY
210 NEXT PX
220 NEXT PY
230 END
