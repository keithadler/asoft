10 REM EIGHTY COLUMNS, FROM THE CARD IN SLOT 3
20 PR#3
30 PRINT "APPLESOFT BASIC FOR DOS": PRINT
40 FOR I = 1 TO 80: PRINT "-";: NEXT : PRINT
50 PRINT "THE COMMA ZONES ARE SIXTEEN COLUMNS WIDE, SO EIGHTY COLUMNS GIVE FIVE:"
60 PRINT
70 PRINT "N","N*N","SQR N","1/N","N!"
80 FOR I = 1 TO 80: PRINT "-";: NEXT : PRINT
90 F = 1
100 FOR N = 1 TO 9
110 F = F * N
120 PRINT N,N * N,SQR(N),1 / N,F
130 NEXT
140 FOR I = 1 TO 80: PRINT "-";: NEXT : PRINT
150 PRINT "AND THE WRAP MOVES WITH IT - THIS LINE IS EXACTLY EIGHTY CHARACTERS LONG.....";
160 PRINT "|WRAPPED"
170 PRINT
180 PRINT "PR#0 PUTS IT BACK TO FORTY."
190 END
