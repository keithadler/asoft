10 REM FOR RE-ENTERED BY GOTO DOES NOT NEST
20 T = T + 1: FOR I = 1 TO 4: IF T < 300 THEN 20
30 PRINT "OK";T;: NEXT : PRINT " DONE"
40 REM UNDIMENSIONED ARRAYS GET 0..10
50 S(1) = 1: S(2) = 2: F(1,1) = 1: F(1,2) = 2
60 PRINT S(2);F(1,2);F(10,10)
70 READ S$,S(3),S(4): PRINT S$;S(3);S(4)
80 DATA A,3,4
90 REM STRING ARRAY COSTS 3 A CELL
100 F0 = FRE(0): DIM D$(128): PRINT F0 - FRE(0)
110 D$(128) = "END": PRINT D$(128)
120 REM LOMEM: MOVES VARIABLES
130 LOMEM: 14080: A = 5: PRINT A
140 PRINT PEEK(105) + 256 * PEEK(106)
150 GOSUB 200
160 ONERR GOTO 180
170 HIMEM: 1000: PRINT "NO ERROR": GOTO 190
180 PRINT "HIMEM ERR";PEEK(222): POKE 216,0
190 PRINT S(11): END
200 PRINT "STILL HERE": RETURN
