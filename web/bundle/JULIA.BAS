10 REM JULIA SET, BANDED BY ESCAPE TIME
15 REM NOTE: TWO LETTERS ARE SIGNIFICANT, SO YY NOT ZY0 -
16 REM ZY0 WOULD BE ZY AND EACH ROW WOULD EAT ITS OWN START
20 HGR
30 CX = - .8: CY = .156
40 FOR PY = 0 TO 47
50 YY = (PY - 24) / 20
60 FOR PX = 0 TO 69
70 ZX = (PX - 35) / 20: ZY = YY
80 N = 0
90 ZT = ZX * ZX - ZY * ZY + CX
100 ZY = 2 * ZX * ZY + CY: ZX = ZT
110 N = N + 1
120 IF ZX * ZX + ZY * ZY < 4 AND N < 16 THEN 90
130 IF N >= 16 THEN HCOLOR= 0: GOTO 190
140 C = N - INT(N / 4) * 4
150 IF C = 0 THEN HCOLOR= 1
160 IF C = 1 THEN HCOLOR= 2
170 IF C = 2 THEN HCOLOR= 5
180 IF C = 3 THEN HCOLOR= 6
190 FOR DY = 0 TO 3
200 HPLOT PX * 4, PY * 4 + DY TO PX * 4 + 3, PY * 4 + DY
210 NEXT DY
220 NEXT PX
230 NEXT PY
240 END
