10 REM HI-RES DEMO
20 HGR
30 HCOLOR=3
40 HPLOT 0,0 TO 279,0 TO 279,191 TO 0,191 TO 0,0
50 REM A SINE WAVE
60 HCOLOR=3
70 FOR X = 2 TO 277
80 Y = 96 + INT(70 * SIN(X / 22))
90 HPLOT X,Y
100 NEXT
110 REM COLOUR BARS - GREEN VIOLET ORANGE BLUE
120 FOR C = 1 TO 2
130 HCOLOR= C
140 FOR X = 20 TO 130: HPLOT X, 20 + C * 8: NEXT
150 NEXT
160 FOR C = 5 TO 6
170 HCOLOR= C
180 FOR X = 150 TO 260: HPLOT X, 20 + (C - 4) * 8: NEXT
190 NEXT
200 REM A BOX OF WHITE
210 HCOLOR=3
220 FOR Y = 150 TO 180: HPLOT 40,Y TO 100,Y: NEXT
230 END
