10 REM BARNSLEY FERN - FOUR AFFINE MAPS, CHOSEN BY WEIGHT
20 HGR
30 HCOLOR= 1
40 X = 0: Y = 0
50 FOR I = 1 TO 12000
60 R = RND(1)
70 IF R < .01 THEN NX = 0: NY = .16 * Y: GOTO 120
80 IF R < .86 THEN NX = .85 * X + .04 * Y: NY = - .04 * X + .85 * Y + 1.6: GOTO 120
90 IF R < .93 THEN NX = .2 * X - .26 * Y: NY = .23 * X + .22 * Y + 1.6: GOTO 120
100 NX = - .15 * X + .28 * Y: NY = .26 * X + .24 * Y + .44
120 X = NX: Y = NY
130 PX = 140 + X * 25
140 PY = 190 - Y * 18
150 IF PX < 0 OR PX > 279 OR PY < 0 OR PY > 191 THEN 170
160 HPLOT PX,PY
170 NEXT
180 END
