10 REM BENCH - A FIXED WORKLOAD, FOR TIMING
20 REM RUN IT WITH -B TO SEE STATEMENTS A SECOND
30 REM ARITHMETIC, STRINGS, ARRAYS, BRANCHES, THEN HI-RES LINES
40 FOR I = 1 TO 3000: X = X + I * 2 / 3: NEXT
50 FOR I = 1 TO 1000: A$ = "ABC" + STR$(I): B = LEN(A$) + VAL(RIGHT$(A$,2)): NEXT
60 DIM V(200): FOR I = 0 TO 200: V(I) = SQR(I) + SIN(I / 7): NEXT
70 FOR I = 1 TO 1000: IF I / 2 = INT(I / 2) THEN C = C + 1
80 NEXT
90 HGR: HCOLOR= 3: FOR I = 0 TO 279 STEP 2: HPLOT I,0 TO 279 - I,191: NEXT
100 TEXT: PRINT "BENCH DONE";X;B;C
