10 REM SPIROGRAPH - A HYPOTROCHOID THAT CLOSES
20 HGR
30 HCOLOR=3
40 R = 72: R2 = 18: D = 54
50 K = (R - R2) / R2
60 FOR T = 0 TO 6.29 STEP .006
70 X = 140 + (R - R2) * COS(T) + D * COS(K * T)
80 Y = 96 + (R - R2) * SIN(T) - D * SIN(K * T)
90 IF X < 0 OR X > 279 OR Y < 0 OR Y > 191 THEN 110
100 HPLOT X,Y
110 NEXT
120 REM A SECOND PASS, TURNED, IN ANOTHER COLOUR
130 HCOLOR=6
140 R2 = 24: D = 46: K = (R - R2) / R2
150 FOR T = 0 TO 6.29 STEP .006
160 X = 140 + (R - R2) * COS(T) + D * COS(K * T)
170 Y = 96 + (R - R2) * SIN(T) - D * SIN(K * T)
180 IF X < 0 OR X > 279 OR Y < 0 OR Y > 191 THEN 200
190 HPLOT X,Y
200 NEXT
210 END
