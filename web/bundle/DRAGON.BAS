10 REM DRAGON CURVE - TURNS TAKEN FROM THE BITS OF THE STEP NUMBER
20 REM WALKED TWICE: ONCE TO FIND ITS SIZE, ONCE TO DRAW IT TO FIT
30 N = 12
40 L = 1: FOR I = 1 TO N: L = L * 2: NEXT
50 FOR P = 0 TO 1
60 X = 0: Y = 0: D = 0
70 IF P = 0 THEN X0 = 0: X1 = 0: Y0 = 0: Y1 = 0
80 IF P = 1 THEN HGR : HCOLOR= 3: SX = 270 / (X1 - X0 + 1): SY = 182 / (Y1 - Y0 + 1)
90 IF P = 1 AND SY < SX THEN SX = SY
100 IF P = 1 THEN SY = SX: HPLOT 5 + (X - X0) * SX, 5 + (Y - Y0) * SY
110 FOR I = 1 TO L - 1
120 K = I
130 IF K - INT(K / 2) * 2 = 0 THEN K = K / 2: GOTO 130
140 T = INT(K / 2) - INT(K / 4) * 2
150 IF T = 0 THEN D = D + 1
160 IF T = 1 THEN D = D - 1
170 IF D > 3 THEN D = D - 4
180 IF D < 0 THEN D = D + 4
190 IF D = 0 THEN X = X + 1
200 IF D = 1 THEN Y = Y - 1
210 IF D = 2 THEN X = X - 1
220 IF D = 3 THEN Y = Y + 1
230 IF P = 1 THEN 280
240 IF X < X0 THEN X0 = X
250 IF X > X1 THEN X1 = X
260 IF Y < Y0 THEN Y0 = Y
270 IF Y > Y1 THEN Y1 = Y
280 IF P = 1 THEN HPLOT TO 5 + (X - X0) * SX, 5 + (Y - Y0) * SY
290 NEXT I
300 NEXT P
310 END
